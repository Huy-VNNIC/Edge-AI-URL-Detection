# Data files (large datasets)
*.csv
*.json
*.parquet
*.h5
*.hdf5

# Except config files
!config/*.yaml
!config/*.json
!base_json/*.json

# Model files (large binary)
*.joblib
*.pkl
*.h5
*.pt
*.pth
*.onnx

# Except documented models
!models/README.md
!models/rf_features.txt

# Logs
logs/*.log
logs/*.txt
*.log

