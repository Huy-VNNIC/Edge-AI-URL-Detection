*.tar
*.tar.gz

# LaTeX
paper/latex/*.aux
paper/latex/*.bbl
paper/latex/*.blg
paper/latex/*.log
paper/latex/*.out
paper/latex/*.toc
paper/latex/*.synctex.gz
paper/latex/*.fls
paper/latex/*.fdb_latexmk

# Keep PDF
!paper/latex/*.pdf

# Reports (optional - comment out if you want to track)
reports/*.json
reports/*.txt
reports/*.png
reports/*.jpg

# System
.cache/
*.tmp
*.bak
